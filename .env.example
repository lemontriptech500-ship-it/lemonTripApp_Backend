PORT=4000
DATABASE_URL=postgres://lemontrip:lemontrip@localhost:5432/lemontrip
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
CORS_ORIGIN=http://localhost:8081,http://localhost:8082
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_IDS=your-google-web-client-id,your-google-android-client-id,your-google-ios-client-id
GOOGLE_CLIENT_SECRET=only-needed-for-server-side-authorization-code-exchange
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
OTP_SENDER=+10000000000
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_resend_api_key
EMAIL_FROM=LemonTrip <auth@example.com>
PUBLIC_API_URL=http://localhost:4000
DEFAULT_PHONE_REGION=IN
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
